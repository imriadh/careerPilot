# ---------- Frontend (safe for the browser, committed to Vercel) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- NEVER put these in the frontend ----------
# The NVIDIA key is a Supabase Edge Function secret, set with:
#   supabase secrets set NVIDIA_API_KEY=nvapi-...
# The Supabase service-role key must never leave the server either.
